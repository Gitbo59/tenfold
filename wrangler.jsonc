{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tenfold",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // Static front-end (public/) is served by the same Worker.
  "assets": { "directory": "./public" },

  // Workers AI: free daily allowance on the Workers Free plan, no API key needed.
  "ai": { "binding": "AI" },

  "durable_objects": {
    "bindings": [
      // One Durable Object per game room (live game + WebSockets).
      { "name": "ROOM", "class_name": "Room" },
      // One global object: daily AI budget, per-connection limits, list cache, reports.
      { "name": "QUOTA", "class_name": "Quota" },
      // One global object: accounts, daily challenge lists, attempts, leaderboards.
      { "name": "ARENA", "class_name": "Arena" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Quota"] },
    { "tag": "v3", "new_sqlite_classes": ["Arena"] }
  ],

  // Builds the next few daily lists once a day (03:15 UTC) so you have time to review them.
  "triggers": { "crons": ["15 3 * * *"] },

  "vars": {
    // Free by default. "anthropic" and "openai" (any OpenAI-compatible API) are optional and may cost money.
    "AI_PROVIDER": "workers-ai",
    // Needs JSON-mode support and must not require a paid plan. See README before changing.
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",

    // ---- Cost protection -------------------------------------------------------------
    // Workers AI gives 10,000 neurons/day free. One request here costs at most about 270
    // neurons (1,200 output tokens max), so 30 requests/day stays under ~8,100 neurons.
    "DAILY_GENERATION_CAP": 30,
    // New AI lists one connection can request per day, and per room.
    "IP_DAILY_GENERATIONS": 4,
    "ROOM_GENERATIONS": 5,
    // Rooms one connection can create per hour.
    "IP_ROOMS_PER_HOUR": 10,
    // Rooms with no activity for this long have their sockets closed (saves Durable Object time).
    "IDLE_MINUTES": 15,

    // ---- Daily challenge (secrets such as AUTH_SECRET and the OAuth client secrets are NOT set here) ----
    "DAILY_TURN_SECONDS": 30,
    "DAILY_DIFFICULTY": "easy",

    // ---- Ranked 1v1 ----
    // Seconds both players have to connect after being matched, and to reconnect before a forfeit.
    "RANKED_JOIN_SECONDS": 45,
    "RANKED_FORFEIT_SECONDS": 60,
    // The acceptable rating gap starts at 100 and widens by this much each second spent waiting.
    "RANKED_WIDEN_PER_SEC": 15,
    // Games a player needs before they appear on the public ladder.
    "RANKED_LADDER_MIN_GAMES": 3
  },

  "observability": { "enabled": true }
}
